cmd_quick() {
  _section "Quick Self-Check"
  
  # Only critical checks
  check_dependencies
  
  _section "Critical Modules"
  local lib_dir="${SWARM_PLATFORM_ROOT:-$PLATFORM_ROOT}/bin/lib"
  local critical_modules=("core.sh" "profiles.sh" "yaml.sh" "docker.sh" "deploy.sh")
  
  for module in "${critical_modules[@]}"; do
