#!/usr/bin/env bash
#===============================================================================
# swarm-selfcheck - Self-diagnostic plugin for swarmcli
#
# Verifies that all modules are loaded correctly and core functions work.
# This plugin performs non-invasive checks to ensure system health.
#
# Usage:
#   swarmcli plugin selfcheck [command] [options]
#   swarmcli selfcheck [command] [options]
#
# Commands:
#   all         Run all checks (default)
#   modules     Check module loading
#   functions   Check core functions
#   deps        Check external dependencies
#   yaml        Test YAML parsing
#   help        Show this help
#
# Options:
#   --verbose   Show detailed output
#   --json      Output in JSON format
#   --quick     Run only critical checks
#
#===============================================================================
set -euo pipefail

# Plugin version
VERSION="1.0.0"

# Colors (if not already set)
_COLOR=1
[ -t 1 ] || _COLOR=0
[ -n "${NO_COLOR:-}" ] && _COLOR=0

_c() {
  if [ "$_COLOR" = "1" ]; then
    printf "\033[%sm%s\033[0m" "$1" "$2"
  else
    printf "%s" "$2"
  fi
}

# Icons
_icon() {
  case "$1" in
    ok)    printf "✓" ;;
    fail)  printf "✗" ;;
    warn)  printf "⚠" ;;
    info)  printf "ℹ" ;;
    skip)  printf "○" ;;
    test)  printf "🧪" ;;
    *)     printf "•" ;;
  esac
}

# Logging
_log() {
  local level="$1"; shift
  local msg="$*"
  
  if [ "${SWARM_FORCE_JSON:-}" = "1" ]; then
    printf '{"level":"%s","msg":"%s"}\n' "$level" "$msg"
    return
  fi
  
  case "$level" in
    ok)    printf "%s %s\n" "$(_c 32 "$(_icon ok)")" "$msg" ;;
    fail)  printf "%s %s\n" "$(_c 31 "$(_icon fail)")" "$msg" ;;
    warn)  printf "%s %s\n" "$(_c 33 "$(_icon warn)")" "$msg" ;;
    info)  printf "%s %s\n" "$(_c 34 "$(_icon info)")" "$msg" ;;
    skip)  printf "%s %s\n" "$(_c 90 "$(_icon skip)")" "$msg" ;;
  esac
}

# Section header
_section() {
  if [ "${SWARM_FORCE_JSON:-}" != "1" ]; then
    printf "\n%s %s\n" "$(_icon test)" "$(_c 1 "$1")"
    printf "%s\n" "$(_c 90 "$(printf '%.0s─' {1..60})")"
  fi
}

# Counters
declare -g CHECKS_PASSED=0
declare -g CHECKS_FAILED=0
declare -g CHECKS_WARNED=0
declare -g CHECKS_SKIPPED=0

# JSON results array
declare -g JSON_RESULTS="[]"

_add_result() {
  local category="$1"
  local check="$2"
  local status="$3"
  local message="${4:-}"
  
  case "$status" in
    ok)   CHECKS_PASSED=$((CHECKS_PASSED + 1)) ;;
    fail) CHECKS_FAILED=$((CHECKS_FAILED + 1)) ;;
    warn) CHECKS_WARNED=$((CHECKS_WARNED + 1)) ;;
    skip) CHECKS_SKIPPED=$((CHECKS_SKIPPED + 1)) ;;
  esac
  
  # Build JSON result
  local json_item
  json_item=$(printf '{"category":"%s","check":"%s","status":"%s","message":"%s"}' \
    "$category" "$check" "$status" "$message")
  
  if [ "$JSON_RESULTS" = "[]" ]; then
    JSON_RESULTS="[$json_item]"
  else
    JSON_RESULTS="${JSON_RESULTS%]},${json_item}]"
  fi
}

# ============================================================================
# Check functions
# ============================================================================

# Check if a function is defined
_fn_exists() {
  declare -f "$1" >/dev/null 2>&1
}

# Check if command exists
_cmd_exists() {
  command -v "$1" >/dev/null 2>&1
}

# Check module syntax (bash -n)
check_module_syntax() {
  local module="$1"
  local name
  name=$(basename "$module" .sh)
  
  if [ ! -f "$module" ]; then
    _log fail "$name: file not found"
    _add_result "modules" "$name" "fail" "file not found"
    return 1
  fi
  
  if bash -n "$module" 2>/dev/null; then
    _log ok "$name: syntax OK"
    _add_result "modules" "$name" "ok" "syntax valid"
    return 0
  else
    _log fail "$name: syntax error"
    _add_result "modules" "$name" "fail" "syntax error"
    return 1
  fi
}

# Check core.sh functions
check_core_functions() {
  local passed=0
  local failed=0
  
  # List of expected functions from core.sh
  local core_functions=(
    "now_iso"
    "c"
    "icon"
    "log"
    "log_json"
    "log_section"
    "log_section_result"
    "fail"
    "with_spinner"
    "ensure_cmd"
    "run_with_timeout"
    "safe_load_env"
    "output_result"
    "add_error"
    "clear_errors"
    "retry_with_backoff"
  )
  
  for fn in "${core_functions[@]}"; do
    if _fn_exists "$fn"; then
      [ "${VERBOSE:-}" = "1" ] && _log ok "  $fn()"
      passed=$((passed + 1))
    else
      _log fail "  $fn() not found"
      failed=$((failed + 1))
    fi
  done
  
  if [ $failed -eq 0 ]; then
    _log ok "core.sh: all $passed functions available"
    _add_result "functions" "core.sh" "ok" "$passed functions"
    return 0
  else
    _log fail "core.sh: $failed/$((passed+failed)) functions missing"
    _add_result "functions" "core.sh" "fail" "$failed functions missing"
    return 1
  fi
}


