# Check dependencies (external commands)
check_dependencies() {
  local critical_deps=("bash" "docker" "git" "jq")
  local optional_deps=("python3" "curl" "timeout")
  
  _section "Critical Dependencies"
  
  for dep in "${critical_deps[@]}"; do
    if _cmd_exists "$dep"; then
      local version=""
      case "$dep" in
        bash)   
          version="$BASH_VERSION" 
          ;;
        docker) 
          version=$(docker --version 2>/dev/null | head -1 | tr -d '\r\n' || echo "")
          version="${version#Docker version }"
          version="${version%%,*}"
          [ -z "$version" ] && version="installed"
          ;;
        git)    
          version=$(git --version 2>/dev/null | cut -d' ' -f3 | tr -d '\r\n' || echo "")
          [ -z "$version" ] && version="installed"
          ;;
        jq)     
          version=$(jq --version 2>/dev/null | tr -d '\r\n' || echo "installed")
          [ -z "$version" ] && version="installed"
          ;;
      esac
      _log ok "$dep: ${version:-available}"
      _add_result "dependencies" "$dep" "ok" "${version:-available}"
    else
      _log fail "$dep: not found"
      _add_result "dependencies" "$dep" "fail" "not installed"
    fi
  done
  
  _section "Optional Dependencies"
  
  for dep in "${optional_deps[@]}"; do
    if _cmd_exists "$dep"; then
      _log ok "$dep: available"
      _add_result "dependencies" "$dep" "ok" "available"
    else
      _log skip "$dep: not installed (optional)"
      _add_result "dependencies" "$dep" "skip" "not installed"
    fi
  done
  
  # Check Docker daemon
  _section "Docker Status"
  
  if _cmd_exists "docker"; then
    local docker_info
    if docker_info=$(docker info 2>&1); then
      _log ok "Docker daemon: running"
      _add_result "docker" "daemon" "ok" "running"
      
      if echo "$docker_info" | grep -q "Swarm: active"; then
        _log ok "Swarm mode: active"
        _add_result "docker" "swarm" "ok" "active"
      else
        _log warn "Swarm mode: not initialized"
        _add_result "docker" "swarm" "warn" "not initialized"
      fi
    else
      _log fail "Docker daemon: not running or not accessible"
      _add_result "docker" "daemon" "fail" "not running"
    fi
  else
    _log skip "Docker: not installed"
    _add_result "docker" "daemon" "skip" "not installed"
  fi
}

# Check module loading
check_all_modules() {
  local lib_dir="${SWARM_PLATFORM_ROOT:-$PLATFORM_ROOT}/bin/lib"
  
  local modules=(
    "core.sh"
    "signals.sh"
    "profiles.sh"
    "yaml.sh"
    "git.sh"
    "docker.sh"
    "locks.sh"
    "deploy.sh"
    "secrets.sh"
    "generator.sh"
    "plugins.sh"
    "validation.sh"
    "dependencies.sh"
    "registry.sh"
    "commands.sh"
    "wizard.sh"
    "args.sh"
    "router.sh"
  )
  
  _section "Module Syntax Check"
  
  local failed=0
  for module in "${modules[@]}"; do
    if ! check_module_syntax "$lib_dir/$module"; then
      failed=$((failed + 1))
    fi
  done
  
  return $failed
}

# Load swarmcli modules for function checking
# This is only needed when running plugin standalone (not through swarmcli)
load_swarmcli_modules() {
  local lib_dir="${SWARM_PLATFORM_ROOT:-$PLATFORM_ROOT}/bin/lib"
  
  # Check if already loaded (c function exists)
  if _fn_exists "c"; then
    _log ok "Modules already loaded (running via swarmcli)"
    _add_result "loader" "modules" "ok" "already loaded"
    return 0
  fi
  
  _section "Loading Modules"
  
  # Define minimal globals needed for modules
  export LOG_FORMAT="${LOG_FORMAT:-text}"
  export QUIET="${QUIET:-0}"
  export VERBOSE="${VERBOSE:-0}"
  export DRY_RUN="${DRY_RUN:-0}"
  export FORCE_JSON="${SWARM_FORCE_JSON:-0}"
  export BIN_DIR="${SWARM_PLATFORM_ROOT:-$PLATFORM_ROOT}/bin"
  export COLOR=1
  [ -t 1 ] || export COLOR=0
  [ -n "${NO_COLOR:-}" ] && export COLOR=0
  
  # Load modules in order
  local modules_to_load=(
    "core.sh"
    "signals.sh"
    "profiles.sh"
    "yaml.sh"
    "git.sh"
    "docker.sh"
    "locks.sh"
    "deploy.sh"
    "secrets.sh"
    "generator.sh"
    "plugins.sh"
    "validation.sh"
    "dependencies.sh"
    "registry.sh"
  )
  
  local loaded=0
  local failed_modules=()
  
  for module in "${modules_to_load[@]}"; do
    local module_path="$lib_dir/$module"
    if [ -f "$module_path" ]; then
      # shellcheck disable=SC1090
      if . "$module_path" 2>/dev/null; then
        loaded=$((loaded + 1))
        [ "${VERBOSE:-}" = "1" ] && _log ok "  Loaded: $module"
      else
        failed_modules+=("$module")
        [ "${VERBOSE:-}" = "1" ] && _log fail "  Failed: $module"
      fi
    else
      failed_modules+=("$module")
    fi
  done
  
  
  if [ ${#failed_modules[@]} -eq 0 ]; then
    _log ok "Loaded $loaded modules successfully"
    _add_result "loader" "modules" "ok" "$loaded modules loaded"
    return 0
  else
    _log warn "Loaded $loaded modules, ${#failed_modules[@]} failed: ${failed_modules[*]}"
    _add_result "loader" "modules" "warn" "${#failed_modules[@]} failed"
    return 1
  fi
}

# Check all function groups
check_all_functions() {
  # First, try to load modules
  load_swarmcli_modules
  
  _section "Core Functions (core.sh)"
  check_core_functions
  
  _section "YAML Functions (yaml.sh)"
