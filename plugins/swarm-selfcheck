  shift || true
  
  # Parse options
  while [ $# -gt 0 ]; do
    case "$1" in
      --verbose)
        export VERBOSE=1
        ;;
      --json)
        export SWARM_FORCE_JSON=1
        _COLOR=0
        ;;
      --help|-h)
        show_help
        return 0
        ;;
      *)
        if [ -z "${cmd:-}" ] || [ "$cmd" = "all" ]; then
          cmd="$1"
        fi
        ;;
    esac
    shift
  done
  
  # Header
  if [ "${SWARM_FORCE_JSON:-}" != "1" ]; then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║  $(_icon test) swarm-selfcheck v${VERSION}                                  ║"
    echo "║  Self-diagnostic for swarmcli modules                         ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
  fi
  
  case "$cmd" in
    --help|-h|help)
      show_help
      ;;
    all)
      cmd_all
      ;;
    modules)
      cmd_modules
      ;;
    functions)
      cmd_functions
      ;;
    deps)
      cmd_deps
      ;;
    yaml)
      cmd_yaml
      ;;
    env)
      cmd_env
      ;;
    quick)
      cmd_quick
      ;;
    *)
      echo "Unknown command: $cmd" >&2
      echo "Run 'swarmcli selfcheck --help' for usage." >&2
      exit 1
      ;;
  esac
}

main "$@"

