  _section "Docker Functions (docker.sh)"
  check_docker_functions
  
  _section "Secrets Functions (secrets.sh)"
  check_secrets_functions
  
  _section "Validation Functions (validation.sh)"
  check_validation_functions
}

# Test YAML parsing with sample data
test_yaml_parsing() {
  _section "YAML Parsing Test"
  
  # Create temp test file
  local tmpfile
  tmpfile=$(mktemp)
  
  cat > "$tmpfile" << 'EOF'
services:
  api:
    type: git
    image: myregistry/api
    repo: git@github.com:org/api.git
    default_branch: main
    build:
      context: .
      dockerfile: Dockerfile
  worker:
    type: registry
    image: redis:7-alpine
EOF
  
  # Test parsing
  if _fn_exists "_yaml_get_indent"; then
    local test_line="    key: value"
    _yaml_get_indent "$test_line"
    if [ "$REPLY" = "4" ]; then
      _log ok "_yaml_get_indent: correct (4 spaces)"
      _add_result "yaml_test" "get_indent" "ok" "correct"
    else
      _log fail "_yaml_get_indent: expected 4, got $REPLY"
      _add_result "yaml_test" "get_indent" "fail" "wrong value"
    fi
  fi
  
  if _fn_exists "_yaml_parse_kv"; then
    _yaml_parse_kv "key: value with spaces"
    if [ "$REPLY_KEY" = "key" ] && [ "$REPLY_VAL" = "value with spaces" ]; then
      _log ok "_yaml_parse_kv: correct parsing"
      _add_result "yaml_test" "parse_kv" "ok" "correct"
    else
      _log fail "_yaml_parse_kv: incorrect parsing"
      _add_result "yaml_test" "parse_kv" "fail" "wrong values"
    fi
  fi
  
  if _fn_exists "_yaml_strip_quotes"; then
    _yaml_strip_quotes '"quoted value"'
    if [ "$REPLY" = "quoted value" ]; then
      _log ok "_yaml_strip_quotes: correct"
      _add_result "yaml_test" "strip_quotes" "ok" "correct"
    else
      _log fail "_yaml_strip_quotes: incorrect"
      _add_result "yaml_test" "strip_quotes" "fail" "wrong value"
    fi
  fi
  
  rm -f "$tmpfile"
}


# Check environment
check_environment() {
  _section "Environment"
  
  # Check platform root
  local platform_root="${SWARM_PLATFORM_ROOT:-${PLATFORM_ROOT:-}}"
  if [ -n "$platform_root" ] && [ -d "$platform_root" ]; then
    _log ok "PLATFORM_ROOT: $platform_root"
    _add_result "environment" "PLATFORM_ROOT" "ok" "$platform_root"
  else
    _log warn "PLATFORM_ROOT: not set or invalid"
    _add_result "environment" "PLATFORM_ROOT" "warn" "not set"
  fi
  
  # Check profile
  local profile="${SWARM_PROFILE:-${ACTIVE_PROFILE:-}}"
  if [ -n "$profile" ]; then
    _log ok "Profile: $profile"
    _add_result "environment" "profile" "ok" "$profile"
  else
    _log info "Profile: not set (OK for selfcheck)"
    _add_result "environment" "profile" "skip" "not required"
  fi
  
  # Check key environment variables
  local env_vars=(
    "DEFAULT_BRANCH"
    "TIMEOUT_SECONDS"
    "SERVICES_READY_TIMEOUT"
  )
  
  for var in "${env_vars[@]}"; do
    local val="${!var:-}"
    if [ -n "$val" ]; then
      _log ok "$var: $val"
      _add_result "environment" "$var" "ok" "$val"
    else
      _log skip "$var: not set (using defaults)"
      _add_result "environment" "$var" "skip" "default"
    fi
  done
}

# Print summary
print_summary() {
  if [ "${SWARM_FORCE_JSON:-}" = "1" ]; then
    printf '{"passed":%d,"failed":%d,"warned":%d,"skipped":%d,"results":%s}\n' \
      "$CHECKS_PASSED" "$CHECKS_FAILED" "$CHECKS_WARNED" "$CHECKS_SKIPPED" "$JSON_RESULTS"
    return
  fi
  
  echo ""
  echo "═══════════════════════════════════════════════════════════════"
  printf " %s Self-Check Summary\n" "$(_icon test)"
  echo "═══════════════════════════════════════════════════════════════"
  echo ""
  printf "  %s Passed:  %d\n" "$(_c 32 "$(_icon ok)")" "$CHECKS_PASSED"
  printf "  %s Failed:  %d\n" "$(_c 31 "$(_icon fail)")" "$CHECKS_FAILED"
  printf "  %s Warnings: %d\n" "$(_c 33 "$(_icon warn)")" "$CHECKS_WARNED"
  printf "  %s Skipped: %d\n" "$(_c 90 "$(_icon skip)")" "$CHECKS_SKIPPED"
  echo ""
  
  if [ "$CHECKS_FAILED" -eq 0 ]; then
    printf "  %s %s\n" "$(_c 32 "$(_icon ok)")" "$(_c 32 "All critical checks passed!")"
  else
    printf "  %s %s\n" "$(_c 31 "$(_icon fail)")" "$(_c 31 "Some checks failed. Review output above.")"
  fi
  echo ""
}

# ============================================================================
# Commands
# ============================================================================

show_help() {
  cat << EOF
swarm-selfcheck v${VERSION}

Self-diagnostic plugin for swarmcli. Verifies that all modules
are loaded correctly and core functions work as expected.

Usage:
  swarmcli plugin selfcheck [command] [options]
  swarmcli selfcheck [command] [options]

Commands:
  all         Run all checks (default)
  modules     Check module syntax only
  functions   Check core functions only
  deps        Check external dependencies only
  yaml        Test YAML parsing
  env         Check environment
  quick       Run only critical checks
  help        Show this help

Options:
  --verbose   Show detailed output for each function
  --json      Output in JSON format
  --help, -h  Show this help

Examples:
  swarmcli selfcheck              # Run all checks
  swarmcli selfcheck --verbose    # Detailed output
  swarmcli selfcheck modules      # Check module syntax only
  swarmcli selfcheck deps         # Check dependencies only
  swarmcli selfcheck --json       # JSON output for automation

Exit Codes:
  0   All checks passed
  1   Some checks failed
EOF
}

cmd_all() {
  check_environment
  check_dependencies
  check_all_modules
  check_all_functions
