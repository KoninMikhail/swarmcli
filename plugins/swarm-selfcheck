}

cmd_functions() {
  check_all_functions
  print_summary
  
  [ "$CHECKS_FAILED" -eq 0 ]
}

cmd_deps() {
  check_dependencies
  print_summary
  
  [ "$CHECKS_FAILED" -eq 0 ]
}

cmd_yaml() {
  test_yaml_parsing
